<script>
	import Alpine from 'alpinejs';

	window.authApp = function() {
		const params = new URLSearchParams(window.location.search);
		const errorParam = params.get('error');
		const viewParam = params.get('view');
		
		const errorMessages = {
			'credenciales': 'Correo o contraseña incorrectos',
			'campos_vacios': 'Por favor complete todos los campos',
			'email_invalido': 'El correo electrónico no es válido',
			'password_corta': 'La contraseña debe tener al menos 8 caracteres',
			'passwords_no_coinciden': 'Las contraseñas no coinciden',
			'email_existe': 'Este correo ya está registrado',
			'registro_fallido': 'Error al crear la cuenta. Intente nuevamente',
			'nombre_vacio': 'Por favor ingrese su nombre'
		};

		return {
			currentView: viewParam || 'landing',
			showPass: false,
			regPassword: '',
			regPasswordConfirm: '',
			errorMsg: errorParam ? (errorMessages[errorParam] || 'Error al procesar solicitud') : '',
			
			validateRegister(e) {
				if (this.regPassword.length < 8) {
					e.preventDefault();
					this.errorMsg = 'La contraseña debe tener al menos 8 caracteres';
					return;
				}
				if (this.regPassword !== this.regPasswordConfirm) {
					e.preventDefault();
					this.errorMsg = 'Las contraseñas no coinciden';
					return;
				}
			}
		};
	};

	if (!window.Alpine) {
		window.Alpine = Alpine;
		Alpine.start();
	}
</script>

