---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="min-h-screen flex" x-data="{ 
		currentView: 'landing',
		registerName: '', registerEmail: '', registerPassword: '', registerPasswordConfirm: '',
		loginEmail: '', loginPassword: '',
		adminPassword: '',
		showPassword: false, showLoginPassword: false,
		errorMsg: '',
		get passwordStrength() {
			const p = this.registerPassword;
			let s = 0;
			if(p.length >= 8) s++;
			if(/[A-Z]/.test(p)) s++;
			if(/[0-9]/.test(p)) s++;
			if(/[^A-Za-z0-9]/.test(p)) s++;
			return s;
		},
		validateRegister(e) {
			if(this.registerPassword.length < 8) { e.preventDefault(); this.errorMsg = 'La contraseña debe tener al menos 8 caracteres'; return; }
			if(this.registerPassword !== this.registerPasswordConfirm) { e.preventDefault(); this.errorMsg = 'Las contraseñas no coinciden'; return; }
		}
	}">
		<!-- ===== LEFT PANEL ===== -->
		<div class="hidden lg:flex lg:w-1/2 relative overflow-hidden flex-col justify-between p-12 text-white"
			style="background: linear-gradient(135deg, #4c1d95 0%, #7c3aed 50%, #a78bfa 100%);">
			
			<div class="absolute inset-0 opacity-10">
				<div class="absolute top-20 left-10 w-72 h-72 bg-white/20 rounded-full blur-3xl"></div>
				<div class="absolute bottom-20 right-10 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
			</div>

			<div class="relative z-10">
				<div class="flex items-center gap-3 mb-2">
					<div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm"><svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg></div>
					<span class="font-bold text-lg">Evaluación de Ludopatía</span>
				</div>
			</div>

			<div class="relative z-10 flex-1 flex flex-col justify-center">
				<span class="bg-white/15 backdrop-blur-sm text-xs font-bold px-4 py-1.5 rounded-full w-fit mb-6 border border-white/20">Plataforma Profesional</span>
				<h1 class="text-5xl font-black leading-tight mb-6">Evaluación de<br/>Ludopatía</h1>
				<p class="text-purple-200 text-lg leading-relaxed max-w-md">
					Evalúa indicadores de conducta de juego patológico: impacto emocional, consecuencias económicas, relaciones y pérdida de control.
				</p>
			</div>

			<div class="relative z-10 grid grid-cols-2 gap-4 mt-8">
				<div class="flex items-center gap-3"><div class="w-10 h-10 bg-white/15 rounded-xl flex items-center justify-center backdrop-blur-sm border border-white/10"><svg class="w-5 h-5 text-purple-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg></div><div><p class="font-bold text-sm">5 Categorías</p><p class="text-purple-200 text-xs">Análisis completo</p></div></div>
				<div class="flex items-center gap-3"><div class="w-10 h-10 bg-emerald-500/15 rounded-xl flex items-center justify-center backdrop-blur-sm border border-emerald-400/10"><svg class="w-5 h-5 text-emerald-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div><div><p class="font-bold text-sm">17 Preguntas</p><p class="text-purple-200 text-xs">Escala 0-3</p></div></div>
				<div class="flex items-center gap-3"><div class="w-10 h-10 bg-amber-500/15 rounded-xl flex items-center justify-center backdrop-blur-sm border border-amber-400/10"><svg class="w-5 h-5 text-amber-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg></div><div><p class="font-bold text-sm">Nivel de Riesgo</p><p class="text-purple-200 text-xs">Bajo a Crítico</p></div></div>
				<div class="flex items-center gap-3"><div class="w-10 h-10 bg-cyan-500/15 rounded-xl flex items-center justify-center backdrop-blur-sm border border-cyan-400/10"><svg class="w-5 h-5 text-cyan-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg></div><div><p class="font-bold text-sm">Diagnóstico</p><p class="text-purple-200 text-xs">Resultado inmediato</p></div></div>
			</div>

			<p class="relative z-10 text-purple-300 text-xs mt-8">&copy; 2025 Evaluación de Ludopatía</p>
		</div>

		<!-- ===== RIGHT PANEL ===== -->
		<div class="w-full lg:w-1/2 flex items-center justify-center p-6 lg:p-12 min-h-screen">
			<div class="w-full max-w-md">
				<button x-show="currentView !== 'landing'" x-cloak @click="currentView = 'landing'; errorMsg = ''" class="flex items-center gap-2 text-gray-500 hover:text-gray-700 mb-6 text-sm font-medium transition">
					<span>←</span> Volver
				</button>
				<div class="h-1 bg-gray-100 rounded-full overflow-hidden mb-8">
					<div class="h-full rounded-full transition-all duration-500 bg-purple-500"
						:style="currentView === 'landing' ? 'width:25%' : currentView === 'login' ? 'width:50%' : currentView === 'register' ? 'width:75%' : 'width:100%'"></div>
				</div>

				<!-- LANDING -->
				<div x-show="currentView === 'landing'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
					<div class="bg-white rounded-3xl p-8 shadow-xl border border-gray-100">
						<div class="text-center mb-8">
							<h2 class="text-2xl font-black text-gray-800">Acceder a la Plataforma</h2>
							<p class="text-gray-500 mt-2">Comienza tu evaluación de ludopatía</p>
						</div>
						<div class="space-y-4">
							<button @click="currentView = 'login'" class="w-full bg-purple-600 text-white font-bold py-4 rounded-2xl shadow-lg hover:bg-purple-700 hover:shadow-xl transition-all flex items-center justify-center gap-2">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg> Iniciar Sesión
							</button>
							<button @click="currentView = 'register'" class="w-full bg-white text-purple-600 font-bold py-4 rounded-2xl shadow-md border-2 border-purple-200 hover:border-purple-400 hover:bg-purple-50 transition-all flex items-center justify-center gap-2">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg> Crear Cuenta
							</button>
						</div>
						<button @click="currentView = 'admin'" class="w-full text-center text-gray-400 text-sm mt-6 hover:text-gray-600 transition flex items-center justify-center gap-1">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg> Acceso Administrador
						</button>
					</div>
				</div>

				<!-- LOGIN -->
				<div x-show="currentView === 'login'" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
					<div class="bg-white rounded-3xl p-8 shadow-xl border border-gray-100">
						<div class="text-center mb-6">
							<div class="w-14 h-14 bg-purple-100 text-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-4 "><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg></div>
							<h2 class="text-2xl font-black text-gray-800">Iniciar Sesión</h2>
							<p class="text-gray-500 mt-1">Ingresa a tu cuenta para continuar</p>
						</div>
						<div x-show="errorMsg" x-cloak class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm font-medium mb-5 text-center" x-text="errorMsg"></div>
						<form action="/evalua_ludopatia/api/auth.php" method="POST" class="space-y-5">
							<input type="hidden" name="type" value="user" />
							<div><label class="auth-label">Correo Electrónico</label><input type="email" name="email" required placeholder="tu@email.com" class="auth-input" x-model="loginEmail" /></div>
							<div class="relative"><label class="auth-label">Contraseña</label><input :type="showLoginPassword ? 'text' : 'password'" name="password" required placeholder="••••••••" class="auth-input pr-12" x-model="loginPassword" /><button type="button" @click="showLoginPassword = !showLoginPassword" class="absolute right-4 top-9 text-gray-400 hover:text-gray-600"><svg x-show="!showLoginPassword" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg><svg x-show="showLoginPassword" x-cloak class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg></button></div>
							<button type="submit" class="w-full bg-purple-600 text-white font-bold py-4 rounded-2xl shadow-lg hover:bg-purple-700 transition-all flex items-center justify-center gap-2"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg> Iniciar Sesión</button>
						</form>
						<p class="text-center mt-6 text-sm text-gray-500"><button @click="currentView = 'register'; errorMsg = ''" class="text-purple-600 font-bold hover:text-purple-700 flex items-center justify-center gap-1 mx-auto"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg> ¿No tienes cuenta? Crear una</button></p>
					</div>
				</div>

				<!-- REGISTER -->
				<div x-show="currentView === 'register'" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
					<div class="bg-white rounded-3xl p-8 shadow-xl border border-gray-100">
						<div class="text-center mb-6">
							<div class="w-14 h-14 bg-purple-100 text-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-4 "><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg></div>
							<h2 class="text-2xl font-black text-gray-800">Crear Cuenta</h2>
							<p class="text-gray-500 mt-1">Únete para evaluar ludopatía</p>
						</div>
						<div x-show="errorMsg" x-cloak class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm font-medium mb-5 text-center" x-text="errorMsg"></div>
						<form action="/evalua_ludopatia/api/register.php" method="POST" class="space-y-4" @submit="validateRegister($event)">
							<div><label class="auth-label">Nombre Completo</label><input type="text" name="nombre" required placeholder="Ingresa tu nombre completo" class="auth-input" x-model="registerName" /></div>
							<div><label class="auth-label">Correo Electrónico</label><input type="email" name="email" required placeholder="tu@email.com" class="auth-input" x-model="registerEmail" /></div>
							<div class="relative"><label class="auth-label">Contraseña</label><input :type="showPassword ? 'text' : 'password'" name="password" required placeholder="••••••••" class="auth-input pr-12" x-model="registerPassword" /><button type="button" @click="showPassword = !showPassword" class="absolute right-4 top-9 text-gray-400 hover:text-gray-600"><svg x-show="!showPassword" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg><svg x-show="showPassword" x-cloak class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg></button></div>
							<div class="flex gap-1 mt-1"><template x-for="i in 4" :key="i"><div class="h-1 flex-1 rounded-full transition-all" :class="passwordStrength >= i ? (passwordStrength <= 2 ? 'bg-red-400' : passwordStrength === 3 ? 'bg-yellow-400' : 'bg-green-400') : 'bg-gray-200'"></div></template></div>
							<div><label class="auth-label">Confirmar Contraseña</label><input :type="showPassword ? 'text' : 'password'" name="password_confirm" required placeholder="••••••••" class="auth-input" x-model="registerPasswordConfirm" /></div>
							<button type="submit" class="w-full bg-purple-600 text-white font-bold py-4 rounded-2xl shadow-lg hover:bg-purple-700 transition-all">Crear Cuenta</button>
						</form>
						<p class="text-center mt-6 text-sm text-gray-500"><button @click="currentView = 'login'; errorMsg = ''" class="text-purple-600 font-bold hover:text-purple-700">¿Ya tienes cuenta? Inicia sesión</button></p>
					</div>
				</div>

				<!-- ADMIN -->
				<div x-show="currentView === 'admin'" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
					<div class="bg-white rounded-3xl p-8 shadow-xl border border-gray-100">
						<div class="text-center mb-6">
							<div class="w-14 h-14 bg-gray-100 text-gray-600 rounded-2xl flex items-center justify-center mx-auto mb-4 "><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div>
							<h2 class="text-2xl font-black text-gray-800">Iniciar Sesión</h2>
							<p class="text-gray-500 mt-1">Ingresa a tu cuenta para continuar</p>
						</div>
						<div x-show="errorMsg" x-cloak class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm font-medium mb-5 text-center" x-text="errorMsg"></div>
						<form action="/evalua_ludopatia/api/auth.php" method="POST" class="space-y-5">
							<input type="hidden" name="type" value="admin" />
							<div><label class="auth-label">Contraseña de Administrador</label><input type="password" name="password" required placeholder="••••••••" class="auth-input" x-model="adminPassword" /></div>
							<button type="submit" class="w-full bg-gray-800 text-white font-bold py-4 rounded-2xl shadow-lg hover:bg-black transition-all flex items-center justify-center gap-2"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg> Acceder al Panel</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script>
	import Alpine from 'alpinejs';
	if (!window.Alpine) { window.Alpine = Alpine; Alpine.start(); }
    const params = new URLSearchParams(window.location.search);
    const errorMsg = params.get('error');
    const view = params.get('view');
    if (errorMsg || view) {
        setTimeout(() => {
            const root = document.querySelector('[x-data]');
            if (root && root.__x) {
                if (view) root.__x.$data.currentView = view;
                if (errorMsg) {
                    const msgs = { credenciales:'Correo o contraseña incorrectos', campos_vacios:'Complete todos los campos', email_invalido:'Email inválido', password_corta:'Contraseña muy corta (mín. 8)', passwords_no_coinciden:'Las contraseñas no coinciden', email_existe:'Este correo ya está registrado', registro_fallido:'Error en el registro' };
                    root.__x.$data.errorMsg = msgs[errorMsg] || 'Error al procesar solicitud';
                }
            }
        }, 100);
    }
</script>

<style>
	[x-cloak] { display: none !important; }
	.auth-label { display: block; font-size: .875rem; font-weight: 600; color: #374151; margin-bottom: .5rem; }
	.auth-input { width: 100%; border: 2px solid #e5e7eb; border-radius: 1rem; padding: .875rem 1rem; outline: none; transition: all .2s; font-size: .95rem; }
	.auth-input:focus { border-color: #7c3aed; box-shadow: 0 0 0 3px rgba(124,58,237,.12); }
</style>
